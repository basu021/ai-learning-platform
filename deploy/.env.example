# Copy to deploy/.env (git-ignored). Used by deploy/db.sh for the Hostinger database.
# hPanel → Databases → MySQL Databases shows these; remote access must allow this server's IP
# (hPanel → Databases → Remote MySQL).
HOSTINGER_DB_HOST=
HOSTINGER_DB_NAME=
HOSTINGER_DB_USER=
# Leave empty to be asked each time.
HOSTINGER_DB_PASSWORD=
