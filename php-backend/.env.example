# SkillForge PHP API settings. Copy to .env next to index.php.

# MySQL / MariaDB. On Hostinger the database host is localhost.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=""
DB_NAME=

# Long random string. Changing it signs everyone out.
JWT_SECRET=
# Signs image links embedded in content; defaults to JWT_SECRET.
# Changing it breaks image links already saved in content.
ATTACHMENT_SECRET=

# The frontend address(es) allowed to call the API, comma separated.
FRONTEND_URL=https://example.com
CORS_ORIGINS=https://example.com

APP_TIMEZONE=Asia/Kolkata
UPLOAD_DIR=./uploads

# Optional: creates this admin on first request if the email doesn't exist.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# Optional: Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://api.example.com/api/auth/google/callback
