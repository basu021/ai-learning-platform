generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  ADMIN
  USER
}

// PUBLIC  - in the catalog, anyone logged in can open it (admin only)
// LISTED  - in the catalog with a marketing preview; full access on request (admin only)
// PRIVATE - only the owner, members and admins
enum Visibility {
  PUBLIC
  LISTED
  PRIVATE
}

enum PublishStatus {
  DRAFT
  PUBLISHED
}

enum NodeType {
  CHAPTER
  TOPIC
  SUBTOPIC
}

enum MemberRole {
  VIEWER
  EDITOR
}

enum RequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ChangeAction {
  CREATE
  UPDATE
  DELETE
}

enum Frequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum StudyEventType {
  OPEN
  COMPLETE
  UNCOMPLETE
  RESET
}

enum OccurrenceStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  username       String    @unique
  passwordHash   String?   @map("password_hash")
  name           String
  avatar         String?
  role           Role      @default(USER)
  provider       String    @default("local") // local, google
  providerId     String?   @map("provider_id")
  emailVerified  Boolean   @default(false) @map("email_verified")
  refreshToken   String?   @db.Text @map("refresh_token")
  level          Int       @default(1)
  totalXp        Int       @default(0) @map("total_xp")
  dailyTaskCount Int       @default(5) @map("daily_task_count")
  dailyHours     Float     @default(2.0) @map("daily_hours")
  difficulty     String    @default("beginner") // beginner, intermediate, advanced, expert
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  ownedSubjects    Subject[]          @relation("SubjectOwner")
  memberships      SubjectMember[]    @relation("MemberUser")
  grantedMembers   SubjectMember[]    @relation("MemberGrantedBy")
  accessRequests   AccessRequest[]    @relation("RequestUser")
  decidedRequests  AccessRequest[]    @relation("RequestDecider")
  changeRequests   ChangeRequest[]    @relation("ChangeAuthor")
  reviewedChanges  ChangeRequest[]    @relation("ChangeReviewer")
  revisions        ContentRevision[]
  attachments      Attachment[]
  createdTasks     Task[]             @relation("TaskCreator")
  assignedTasks    Task[]             @relation("TaskAssignee")
  occurrences      TaskOccurrence[]
  taskSessions     TaskSession[]
  feedback         Feedback[]
  streaks          Streak[]
  achievements     UserAchievement[]
  xpHistory        XpHistory[]
  learningProgress LearningProgress[]
  notifications    Notification[]
  readProgress     ReadProgress[]
  studyEvents      StudyEvent[]
  studyTime        StudyTime[]

  @@map("users")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  createdAt   DateTime  @default(now()) @map("created_at")
  subjects    Subject[]

  @@map("categories")
}

model Subject {
  id          String        @id @default(uuid())
  ownerId     String        @map("owner_id")
  title       String
  summary     String?       @db.VarChar(1000)
  content     String?       @db.LongText
  visibility  Visibility    @default(PRIVATE)
  status      PublishStatus @default(DRAFT)
  categoryId  String?       @map("category_id")
  tags        String?       @db.VarChar(500) // comma separated
  color       String?       @default("#6366f1")
  // Last change to title/summary/content; drives "updated since you read it".
  contentUpdatedAt DateTime   @default(now()) @map("content_updated_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deletedAt   DateTime?     @map("deleted_at")

  owner          User              @relation("SubjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  category       Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  nodes          ContentNode[]
  members        SubjectMember[]
  accessRequests AccessRequest[]
  changeRequests ChangeRequest[]
  revisions      ContentRevision[]
  attachments    Attachment[]
  tasks          Task[]

  @@index([ownerId])
  @@index([visibility, status])
  @@map("subjects")
}

// Chapter -> Topic -> Subtopic, all under one Subject.
model ContentNode {
  id        String    @id @default(uuid())
  subjectId String    @map("subject_id")
  parentId  String?   @map("parent_id")
  type      NodeType
  title     String
  summary   String?   @db.VarChar(1000)
  content   String?   @db.LongText
  order     Int       @default(0)
  isPreview Boolean   @default(false) @map("is_preview") // visible to everyone on LISTED subjects
  hasContent Boolean  @default(false) @map("has_content")
  // Last change to title/summary/content (not order/preview); drives "updated since you read it".
  contentUpdatedAt DateTime @default(now()) @map("content_updated_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  subject     Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  parent      ContentNode?      @relation("NodeTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    ContentNode[]     @relation("NodeTree")
  revisions   ContentRevision[]
  changes     ChangeRequest[]
  attachments Attachment[]
  tasks       Task[]

  @@index([subjectId, parentId])
  @@map("content_nodes")
}

model SubjectMember {
  id          String     @id @default(uuid())
  subjectId   String     @map("subject_id")
  userId      String     @map("user_id")
  role        MemberRole @default(VIEWER)
  grantedById String?    @map("granted_by_id")
  createdAt   DateTime   @default(now()) @map("created_at")

  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user      User    @relation("MemberUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User?   @relation("MemberGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([subjectId, userId])
  @@index([userId])
  @@map("subject_members")
}

model AccessRequest {
  id          String        @id @default(uuid())
  subjectId   String        @map("subject_id")
  userId      String        @map("user_id")
  message     String?       @db.VarChar(1000)
  status      RequestStatus @default(PENDING)
  decidedById String?       @map("decided_by_id")
  decidedAt   DateTime?     @map("decided_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  user      User    @relation("RequestUser", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?   @relation("RequestDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([subjectId, status])
  @@index([userId])
  @@map("access_requests")
}

// An edit by a non-owner editor, waiting for the owner's approval.
// nodeId null + action UPDATE = subject-level edit; action CREATE uses payload.parentId/type.
model ChangeRequest {
  id           String        @id @default(uuid())
  subjectId    String        @map("subject_id")
  nodeId       String?       @map("node_id")
  action       ChangeAction
  payload      Json
  changeNote   String?       @db.VarChar(500) @map("change_note")
  authorId     String        @map("author_id")
  status       RequestStatus @default(PENDING)
  reviewedById String?       @map("reviewed_by_id")
  reviewNote   String?       @db.VarChar(500) @map("review_note")
  reviewedAt   DateTime?     @map("reviewed_at")
  createdAt    DateTime      @default(now()) @map("created_at")

  subject    Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  node       ContentNode? @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  author     User         @relation("ChangeAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewedBy User?        @relation("ChangeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([subjectId, status])
  @@map("change_requests")
}

// Snapshot of the state *before* a change was applied. Only the latest 3 per entity are kept.
model ContentRevision {
  id          String       @id @default(uuid())
  subjectId   String       @map("subject_id")
  nodeId      String?      @map("node_id")
  action      ChangeAction
  snapshot    Json
  changeNote  String?      @db.VarChar(500) @map("change_note")
  changedById String       @map("changed_by_id")
  createdAt   DateTime     @default(now()) @map("created_at")

  subject   Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  node      ContentNode? @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  changedBy User         @relation(fields: [changedById], references: [id], onDelete: Cascade)

  @@index([subjectId, nodeId, createdAt])
  @@map("content_revisions")
}

model Attachment {
  id           String   @id @default(uuid())
  subjectId    String   @map("subject_id")
  nodeId       String?  @map("node_id")
  filename     String
  contentType  String?  @map("content_type")
  sizeBytes    Int      @map("size_bytes")
  storagePath  String   @map("storage_path")
  checksum     String   @db.Char(64)
  inline       Boolean  @default(false) // embedded in editor content (images)
  uploadedById String   @map("uploaded_by_id")
  createdAt    DateTime @default(now()) @map("created_at")

  subject    Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  node       ContentNode? @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  uploadedBy User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([subjectId, nodeId])
  @@map("attachments")
}

// A practice task scoped to a subject or any node beneath it, with its recurrence rule.
model Task {
  id            String    @id @default(uuid())
  subjectId     String    @map("subject_id")
  nodeId        String?   @map("node_id")
  createdById   String    @map("created_by_id")
  assigneeId    String    @map("assignee_id")
  title         String
  instructions  String?   @db.LongText
  difficulty    String    @default("beginner") // beginner, intermediate, advanced, expert
  estimatedMins Int?      @map("estimated_mins")
  xpReward      Int       @default(10) @map("xp_reward")
  frequency     Frequency @default(ONCE)
  weekdays      String?   // WEEKLY: comma separated 0-6 (Sun-Sat)
  monthDay      Int?      @map("month_day") // MONTHLY: 1-31, clamped to month end
  intervalDays  Int?      @map("interval_days") // CUSTOM: every N days
  startDate     DateTime  @db.Date @map("start_date")
  endDate       DateTime? @db.Date @map("end_date")
  generatedThru DateTime? @db.Date @map("generated_thru")
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  subject     Subject          @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  node        ContentNode?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  createdBy   User             @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignee    User             @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)
  occurrences TaskOccurrence[]

  @@index([assigneeId, active])
  @@index([subjectId])
  @@map("tasks")
}

model TaskOccurrence {
  id          String           @id @default(uuid())
  taskId      String           @map("task_id")
  userId      String           @map("user_id")
  dueDate     DateTime         @db.Date @map("due_date")
  status      OccurrenceStatus @default(PENDING)
  completedAt DateTime?        @map("completed_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  task         Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskSessions TaskSession[]
  feedback     Feedback[]

  @@unique([taskId, dueDate])
  @@index([userId, dueDate])
  @@map("task_occurrences")
}

model TaskSession {
  id           String    @id @default(uuid())
  occurrenceId String    @map("occurrence_id")
  userId       String    @map("user_id")
  startedAt    DateTime  @default(now()) @map("started_at")
  finishedAt   DateTime? @map("finished_at")
  duration     Int? // seconds
  status       String    @default("active") // active, completed, abandoned
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  occurrence TaskOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([occurrenceId])
  @@index([userId])
  @@map("task_sessions")
}

model Feedback {
  id               String   @id @default(uuid())
  occurrenceId     String   @map("occurrence_id")
  userId           String   @map("user_id")
  whatWasDone      String?  @db.Text @map("what_was_done")
  problemsFaced    String?  @db.Text @map("problems_faced")
  commandsUsed     String?  @db.Text @map("commands_used")
  confidenceLevel  Int      @default(3) @map("confidence_level") // 1-5
  needsImprovement String?  @db.Text @map("needs_improvement")
  notesForTomorrow String?  @db.Text @map("notes_for_tomorrow")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  occurrence TaskOccurrence @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([occurrenceId])
  @@index([userId])
  @@map("feedback")
}

model Streak {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  type         String   @default("daily")
  currentCount Int      @default(0) @map("current_count")
  longestCount Int      @default(0) @map("longest_count")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("streaks")
}

model Achievement {
  id          String   @id @default(uuid())
  name        String   @unique
  description String   @db.Text
  icon        String?
  category    String // streak, mastery, completion, special
  xpReward    Int      @default(0) @map("xp_reward")
  condition   String   @db.Text // JSON condition definition
  createdAt   DateTime @default(now()) @map("created_at")

  users UserAchievement[]

  @@map("achievements")
}

model UserAchievement {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  achievementId String   @map("achievement_id")
  unlockedAt    DateTime @default(now()) @map("unlocked_at")

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@map("user_achievements")
}

model XpHistory {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  amount    Int
  source    String // task_completion, achievement, streak_bonus
  sourceId  String?  @map("source_id")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("xp_history")
}

// Progress per practised scope; scopeKey is the nodeId, or the subjectId for subject-level tasks.
model LearningProgress {
  id              String    @id @default(uuid())
  userId          String    @map("user_id")
  subjectId       String    @map("subject_id")
  scopeKey        String    @map("scope_key")
  mastery         Float     @default(0) // 0-100
  tasksCompleted  Int       @default(0) @map("tasks_completed")
  avgConfidence   Float     @default(0) @map("avg_confidence")
  avgTimeSpent    Float     @default(0) @map("avg_time_spent")
  lastPracticedAt DateTime? @map("last_practiced_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scopeKey])
  @@index([userId, subjectId])
  @@map("learning_progress")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  title     String
  message   String   @db.Text
  type      String // share, assign, access_request, change_request, review, achievement, system
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

// Reading state per user and item (subject overview: nodeId null, scopeKey = subjectId).
model ReadProgress {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  subjectId     String    @map("subject_id")
  nodeId        String?   @map("node_id")
  scopeKey      String    @map("scope_key")
  firstOpenedAt DateTime? @map("first_opened_at") // cleared on reset, so it marks the current attempt
  lastOpenedAt  DateTime? @map("last_opened_at")
  completedAt   DateTime? @map("completed_at")
  timeSpentSec  Int       @default(0) @map("time_spent_sec") // lifetime, survives resets
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scopeKey])
  @@index([userId, subjectId])
  @@map("read_progress")
}

// Append-only study log for later analytics (time to complete, re-reads, resets).
model StudyEvent {
  id        String         @id @default(uuid())
  userId    String         @map("user_id")
  subjectId String         @map("subject_id")
  nodeId    String?        @map("node_id")
  type      StudyEventType
  createdAt DateTime       @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, subjectId, createdAt])
  @@map("study_events")
}

// Reading time per user, item and day.
model StudyTime {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  subjectId String   @map("subject_id")
  nodeId    String?  @map("node_id")
  scopeKey  String   @map("scope_key")
  day       DateTime @db.Date
  seconds   Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scopeKey, day])
  @@index([userId, subjectId, day])
  @@map("study_time")
}
