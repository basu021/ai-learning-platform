# ===========================================
# SkillForge Backend - Environment Variables
# ===========================================
# Copy this file to .env and fill in the values

# ---------- Database ----------
DATABASE_URL="mysql://root:password@localhost:3306/ai_learning_platform"
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="root"
DB_PASSWORD="password"
DB_NAME="ai_learning_platform"

# ---------- JWT / Auth ----------
JWT_SECRET="change-me-to-a-random-secret"

# ---------- Google OAuth ----------
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"

# ---------- Frontend ----------
FRONTEND_URL="http://localhost:3000"

# ---------- Redis ----------
REDIS_URL="redis://localhost:6379"

# ---------- Server ----------
PORT=3001

# ---------- AI Providers ----------
AI_PROVIDER="openai"               # openai | gemini | claude | ollama
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
GEMINI_API_KEY=""
CLAUDE_API_KEY=""
OLLAMA_BASE_URL="http://localhost:11434"

# ---------- SMTP / Email (Hostinger) ----------
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="noreply@yourdomain.com"
SMTP_PASSWORD=""
SMTP_FROM_NAME="SkillForge"
SMTP_FROM_EMAIL="noreply@yourdomain.com"

# ---------- Admin ----------
ADMIN_SETUP_KEY=""                  # One-time key to bootstrap the first admin user
