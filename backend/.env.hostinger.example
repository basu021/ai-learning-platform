# Upload/import this file in Hostinger's Web App environment-variable screen.
# Replace every example value. Do not commit the completed file.

# Hostinger MySQL (the host is normally localhost for a database on the same plan)
DB_HOST=localhost
DB_PORT=3306
DB_USER=u123456789_skillforge
DB_PASSWORD=replace-with-database-password
DB_NAME=u123456789_skillforge

# Do not set PORT. Hostinger supplies the runtime port.
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_SETUP_KEY=replace-with-a-different-long-random-secret

# Public URLs, with no trailing slash
FRONTEND_URL=https://example.com
GOOGLE_CALLBACK_URL=https://api.example.com/api/auth/google/callback

# Optional Google sign-in. Leave disabled unless credentials are configured in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional AI provider. The app has fallback task templates when no key is set.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
CLAUDE_API_KEY=
OLLAMA_BASE_URL=

# Optional email
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@example.com
SMTP_PASSWORD=
SMTP_FROM_NAME=SkillForge
SMTP_FROM_EMAIL=noreply@example.com

